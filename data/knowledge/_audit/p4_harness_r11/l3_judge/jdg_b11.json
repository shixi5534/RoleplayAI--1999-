{"items":[{"qid":"R016","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":3,"n_supported":3,"why":"明确留白，所举两篇开场人物与情节均可在片段中逐句核对。"},{"qid":"R019","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":3,"n_supported":3,"why":"拒答理由准确：片段仅有星之眼递钥匙与十四行诗翻档案。"},{"qid":"R029","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":3,"n_supported":3,"why":"如实指出片段无“血痛”及其英文写法，留白到位。"},{"qid":"R044","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":2,"n_supported":2,"why":"片段只出现中文“阿派朗”，英文名确未记载，拒答成立。"},{"qid":"R062","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":2,"n_supported":2,"why":"所概括的传说内容与“无具名怪物”均核对无误。"},{"qid":"R063","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":2,"n_supported":2,"why":"人物列举与“无英文名”判断均与片段一致。"},{"qid":"R064","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":2,"n_supported":2,"why":"洁西卡与安妮关系有原句支撑，英文名留白。"},{"qid":"R065","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":2,"n_supported":2,"why":"迈克尔身份描述有依据，英文名确未给出。"},{"qid":"R066","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":2,"n_supported":2,"why":"弗莱迪身份与“仅以中文名出现”均与片段相符。"},{"qid":"R067","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":2,"n_supported":2,"why":"四个片段确无“冷周六”，拒答理由充分。"},{"qid":"R071","persona":3,"voice":5,"faithfulness":0.67,"refusal":true,"hallucination":true,"n_claims":3,"n_supported":2,"why":"把别处片段的“巨大/变异魔精”算进本片段，属无据补充。"},{"qid":"R076","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":5,"n_supported":5,"why":"引述与“未点名怪物”结论均可逐句核对，解说克制。"},{"qid":"R091","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":2,"n_supported":2,"why":"型号名与“安保机器人”称呼有原文，英文名留白。"},{"qid":"R095","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":2,"n_supported":2,"why":"梅林仅见于图谱与关系脉络，正文无其人，判断准确。"},{"qid":"R096","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":3,"n_supported":3,"why":"正文确无诺亚，仅实体表列“诺亚方舟”，拒答得当。"},{"qid":"R097","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":3,"n_supported":3,"why":"正文只有梁月、波蒂埃、奇星等，斯科特未登场。"},{"qid":"R098","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":2,"n_supported":2,"why":"英文名直接取自片段标牌文字“Farewell, Rayashki”。"},{"qid":"R099","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":3,"n_supported":3,"why":"所举少年名单与“无奥古斯特、无英文名”均属实。"},{"qid":"R100","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":2,"n_supported":2,"why":"叶甫根尼相关情节有原句，英文名确未记载。"},{"qid":"R101","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":2,"n_supported":2,"why":"克努特情节描述准确，英文名确未给出，留白得当。"}]}
