{"items":[{"qid":"BD-004","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":1,"n_supported":1,"why":"仅复述“我们称它为‘流溢’”，原句可证，无外推。"},{"qid":"BD-005","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":1,"n_supported":1,"why":"210原话即点名苏菲亚为其最好朋友，未加料。"},{"qid":"BD-006","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":1,"n_supported":1,"why":"1980年出自37原句，完全落句。"},{"qid":"BD-007","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":1,"n_supported":1,"why":"每216年转世直接引自原句，无增补。"},{"qid":"BD-008","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":4,"n_supported":4,"why":"祖父称呼与图谱登记姓名均见题面，未编探险事迹，留白得当。"},{"qid":"BD-009","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":5,"n_supported":5,"why":"刻录编号、独立编制与Su-01ве标识均为原句转述。"},{"qid":"BD-010","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":5,"n_supported":5,"why":"雪地摩托、喊“不”者与“唯一载具”皆见原文。"},{"qid":"BD-011","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":2,"n_supported":2,"why":"拉斑玄武岩与深海大洋中脊直接引原句。"},{"qid":"BD-012","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":1,"n_supported":1,"why":"抄录者姓氏“卡文迪许”原文可见。"},{"qid":"BD-013","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":4,"n_supported":4,"why":"奥兹身份、黑藻构成与无毒验证均系原文转述。"},{"qid":"BD-014","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":2,"n_supported":2,"why":"两句咒语及先后作用与原句一致。"},{"qid":"BD-015","persona":1,"voice":5,"faithfulness":0.0,"refusal":false,"hallucination":true,"n_claims":4,"n_supported":0,"why":"“闭眼见真方向”及德洛丝、犬群穿迷宫之说本段context全无依据。"},{"qid":"BD-016","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":5,"n_supported":5,"why":"龙涎香、乳色石块与“好消息”称呼皆见原文。"},{"qid":"BD-017","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":2,"n_supported":2,"why":"明确声明那句话未记载，仅转述赛鹿节大鼓与其心愿。"},{"qid":"BD-018","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":1,"n_supported":1,"why":"1999年直接引自伊戈尔原句。"},{"qid":"BD-019","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":1,"n_supported":1,"why":"1.414秒为原文数值，并正确指出“熔岩甬道”非原文。"},{"qid":"BD-020","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":3,"n_supported":3,"why":"冷周六、醒来十五分钟与签协议细节均见原文。"},{"qid":"BD-021","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":2,"n_supported":2,"why":"阿涅娅为科兹洛夫当面称呼，原文可证。"},{"qid":"BD-022","persona":5,"voice":5,"faithfulness":1.0,"refusal":true,"hallucination":false,"n_claims":1,"n_supported":1,"why":"正确声明片段未给真名，只复述其职务与称呼。"},{"qid":"BD-023","persona":5,"voice":5,"faithfulness":1.0,"refusal":false,"hallucination":false,"n_claims":5,"n_supported":5,"why":"数据卡、电子遗书与研究资料均系原文转述。"}]}
