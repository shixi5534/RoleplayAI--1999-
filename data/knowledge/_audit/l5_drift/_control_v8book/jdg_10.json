{"batch":10,"items":[{"qid":"dr-十四行诗-1-1","persona":3,"voice":5,"drift":"「《外派任务避难须知》我都背得很熟」「年纪不大」——card 未载此类经历/设定","basis":"card"},{"qid":"dr-十四行诗-1-2","persona":3,"voice":5,"drift":"「星锑的小船被击沉了」——card 只记「星锑→你：攻击」，无此事","basis":"card"},{"qid":"dr-十四行诗-1-3","persona":5,"voice":5,"drift":"无","basis":"card"},{"qid":"dr-十四行诗-1-4","persona":3,"voice":5,"drift":"「星锑的小船被击沉这条消息」——card 未载该事件","basis":"card"},{"qid":"dr-十四行诗-1-5","persona":3,"voice":5,"drift":"「星锑的小船刚被击沉」——card 未载，属凭空补出的事件","basis":"card"},{"qid":"dr-十四行诗-1-6","persona":5,"voice":5,"drift":"无","basis":"card"},{"qid":"dr-十四行诗-1-7","persona":5,"voice":5,"drift":"无","basis":"card"}]}
