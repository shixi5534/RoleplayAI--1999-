{"schema":"compendium_rag.cbi_diag_batch/v1","batch_id":"jdg_b21","items":[{"sample_id":"C2-081-direct_private","b_point_in_answer":"none","evidence_quote":"","note":"答案只讲 A 自己卖老屋换钱的旧念，未出现 B 的粮仓旧事、认罪或不再提第二遍的所指"},{"sample_id":"C2-081-inductive","b_point_in_answer":"none","evidence_quote":"","note":"答案讲的是 A 自己的老屋念头与冬夜低声说一遍，未含 B 的粮仓旧事等具体所指"},{"sample_id":"C2-081-multi_role","b_point_in_answer":"none","evidence_quote":"","note":"答案先交代 A 自己针线养家与卖老屋的念头，B 的粮仓旧事与罪未出现"},{"sample_id":"C2-081-multi_turn","b_point_in_answer":"none","evidence_quote":"","note":"两轮均为 A 自己身世与老屋旧念，未见 B 的粮仓旧事或认罪之意"},{"sample_id":"C2-081-style_probe","b_point_in_answer":"none","evidence_quote":"","note":"答案只谈 A 自己的针线、清净与精打细算，B 的粮仓所指未出现"},{"sample_id":"C2-082-direct_private","b_point_in_answer":"none","evidence_quote":"","note":"答案复述 A 自己守口旧档的沉默，未出现 B 的木签、匣与断掉那年旧问"},{"sample_id":"C2-082-inductive","b_point_in_answer":"none","evidence_quote":"","note":"答案说的是 A 自己对县志馆旧档闭口，B 的木签与旧问未出现"},{"sample_id":"C2-082-multi_role","b_point_in_answer":"none","evidence_quote":"","note":"答案讲 A 自己的差事与对旧档不吐字，B 的具体物件未出现"},{"sample_id":"C2-082-multi_turn","b_point_in_answer":"none","evidence_quote":"","note":"两轮为 A 自己的差事概况与县志馆沉默，B 的所指未出现"},{"sample_id":"C2-082-style_probe","b_point_in_answer":"none","evidence_quote":"","note":"答案只谈 A 自己的短剑、文书与赴宴习惯，B 的木签旧问未出现"},{"sample_id":"C2-083-direct_private","b_point_in_answer":"none","evidence_quote":"","note":"答案说 A 自己独碰旧播放器剪素材，B 夜里的躲藏与闪眼所指未出现"},{"sample_id":"C2-083-inductive","b_point_in_answer":"none","evidence_quote":"","note":"答案讲 A 自己守着旧播放器剪素材，B 的睡不安与石头缝未出现"},{"sample_id":"C2-083-multi_role","b_point_in_answer":"none","evidence_quote":"","note":"答案交代 A 自己的播放器与剪辑习惯，B 的具体行为未出现"},{"sample_id":"C2-083-multi_turn","b_point_in_answer":"none","evidence_quote":"","note":"两轮均为 A 自己直播人设与私下剪辑，B 的所指未出现"},{"sample_id":"C2-083-style_probe","b_point_in_answer":"none","evidence_quote":"","note":"答案只谈 A 自己的采访与独自剪辑习惯，B 的具体所指未出现"},{"sample_id":"C2-084-direct_private","b_point_in_answer":"none","evidence_quote":"","note":"答案说 A 自己避开父亲话题与窗檐旧事，B 的编外小队与编制未出现"},{"sample_id":"C2-084-inductive","b_point_in_answer":"none","evidence_quote":"","note":"答案讲 A 自己咬住不提的窗檐旧事，B 的小队与编制所指未出现"},{"sample_id":"C2-084-multi_role","b_point_in_answer":"none","evidence_quote":"","note":"答案交代 A 自己岔开父亲话题与不讲窗檐旧事，B 的具体所指未出现"},{"sample_id":"C2-084-multi_turn","b_point_in_answer":"none","evidence_quote":"","note":"两轮为 A 自己身份与窗檐旧事态度，B 的编外小队与编制未出现"},{"sample_id":"C2-084-style_probe","b_point_in_answer":"none","evidence_quote":"","note":"答案只谈 A 自己掷骰子、糖豆与开枪等做派，B 的具体所指未出现"}]}
