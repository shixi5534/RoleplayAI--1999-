# 复制为 .env 并按需修改。所有变量以 ROLEPLAY_ 前缀注入（见 src/roleplay/config.py）
ROLEPLAY_APP_NAME=RoleplayAI
ROLEPLAY_DEBUG=false
# 本地开发建议 true（禁用前端缓存）；生产部署可设 false 恢复缓存
ROLEPLAY_STATIC_NO_CACHE=true

# ---- LLM（默认 mock，无需任何 Key 即可离线运行/测试）----
ROLEPLAY_LLM_PROVIDER=mock
ROLEPLAY_LLM_MODEL=mock-model
ROLEPLAY_LLM_API_KEY=
ROLEPLAY_LLM_BASE_URL=
ROLEPLAY_LLM_TEMPERATURE=0.8

# ---- 情感 / Live2D ----
ROLEPLAY_ENABLE_EMOTION=true
ROLEPLAY_ENABLE_LIVE2D=false
ROLEPLAY_LIVE2D_MODEL_PATH=
ROLEPLAY_LIVE2D_DEFAULT_MODEL_ID=wmz_314701

# ---- RAG ----
ROLEPLAY_RAG_IMPL=memory
ROLEPLAY_CHROMA_PERSIST_DIR=./data/chroma
ROLEPLAY_CHUNK_SIZE=600
ROLEPLAY_TOP_K=3

# ---- 安全 / 限流 ----
ROLEPLAY_MAX_MESSAGE_LENGTH=4000
ROLEPLAY_MAX_TOKENS_PER_REPLY=2000

# ---- 语音（STT / TTS 后端，均为可选回退）----
# 默认全部关闭：前端优先用浏览器原生 Web Speech API；
# 仅当显式开启后，/voice/* 才走后端适配器（faster-whisper / Edge-TTS）。
# 开启 STT 前需先准备 faster-whisper 模型：
#   方式A（推荐，国内网络）：从 hf-mirror.com 下载 base 模型到本地目录，
#     再设置 ROLEPLAY_WHISPER_MODEL_PATH 指向该目录。
#     模型文件：config.json / model.bin / tokenizer.json / vocabulary.txt
#   方式B：留空 ROLEPLAY_WHISPER_MODEL_PATH，首次调用时 faster-whisper
#     会尝试从 HuggingFace 自动下载（国内网络可能超时）。
ROLEPLAY_STT_BACKEND_ENABLED=false
ROLEPLAY_WHISPER_MODEL=base          # tiny / base / small / medium / large-v3
ROLEPLAY_WHISPER_MODEL_PATH=         # 本地模型目录（推荐：C:/Users/<你>/fw_model）
ROLEPLAY_TTS_BACKEND_ENABLED=false
ROLEPLAY_EDGE_TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
ROLEPLAY_TTS_DEFAULT_FORMAT=mp3
ROLEPLAY_VOICE_REQUEST_TIMEOUT=30.0

# ---- QQ 渠道（NapCatQQ / OneBot v11，默认关闭）----
# 让一个 QQ 号（建议小号）通过 NapCat 协议端登录，消息转 OneBot v11 交给本服务，
# 回复再发回 QQ。人设/RAG/情感/记忆全部复用。详见 docs/QQ_INTEGRATION.md。
# ⚠️ 协议端登录属灰色地带，务必用小号，避免主号风控。
ROLEPLAY_QQ_ENABLED=false
ROLEPLAY_QQ_NAPCAT_WS_URL=ws://127.0.0.1:3001   # NapCat 正向 OneBot v11 WebSocket 地址
ROLEPLAY_QQ_WS_TOKEN=                            # 与 NapCat 配置一致；空=不鉴权
ROLEPLAY_QQ_BOT_UIN=                             # 机器人QQ号；空则启动时自动获取
ROLEPLAY_QQ_ADMIN_UIN=                           # 管理员QQ号（指令权限）；空=对所有人开放
ROLEPLAY_QQ_CHARACTER_ID=                        # QQ 上默认扮演的角色 id；空=当前激活角色
ROLEPLAY_QQ_GROUP_AT_ONLY=true                   # 群内仅 @机器人 才回复
ROLEPLAY_QQ_COMMAND_PREFIX=!
ROLEPLAY_QQ_ALLOW_FROM=                          # 私聊白名单QQ号（逗号分隔）；空=允许所有人
