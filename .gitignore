# 依赖与虚拟环境
.venv/
__pycache__/
*.pyc
*.egg-info/

# 数据与本地配置
# 原则：只入库「不可再生的种子」，派生产物一律不入库。
#   种子（入库）：data/lore 原始文案、data/characters 角色卡、data/knowledge 的
#                 检索产物（剧情语料/剧情图谱/时间线/审计报告/云端抽取结果）
#   派生（不入库）：向量库 / 抽取缓存 / 备份 / 归档 —— 均由种子 + scripts 重建；
#                   且向量库每次重嵌会全量变化，进 git 会让快照体积爆炸
data/*
!data/lore/
!data/characters/
!data/knowledge/
data/lore/_bilibili_tmp/
# 知识库排除项（2026-09-12 入库策略：核心可检索产物 21MB 入库，其余 152MB 排除）
#   向量库：绑定具体嵌入模型（本项目为 nomic-embed-text），换模型即失效且可重建
data/knowledge/lore_*.json
data/knowledge/graph_*.json
data/knowledge/web.json
data/knowledge/persona.json
#   剧情语义向量索引（M8，约 45MB）：与嵌入模型强绑定，指纹不符即自动停用，
#   删掉等于本层不存在（可回滚），用 scripts/build_plot_index.py --build 重建即可
data/knowledge/plot_index_*.npz
#   抽取缓存（plot_cache*/graph_cache*，约 1.6 万个文件）与备份/归档
data/knowledge/*cache*/
data/knowledge/*.bak*
data/knowledge/_archive/
src/data/
.env
.env.*.local
.env.*.bak*

# 运行日志
logs/

# 测试缓存
.pytest_cache/

# 审计/探针临时目录（沙箱下 pytest 临时目录与探针产物）
tmp_pytest/
.pytest_tmp*/

# 编辑器
.idea/
.vscode/

# 临时/备份文件
*.bak
*.bak-*
*.tmp
*.log

# 一次性抽取/探针产物（勿入库）
_shuzhi_extract.txt
_tmp_pron_edges.txt
docs/_tmp_voicestat.txt

# 第三方可下载模型与语言包（运行时按需下载，不入库）
desktop/resources/ocr/traineddata/
#   同上：bge-reranker 的 ONNX 权重（1.1 G + 279 M），可从 HuggingFace 重新下载
models/**/*.onnx
#   同上：bge-reranker-large / bge-reranker-v2-m3 的 safetensors 全量权重（约 4.4 GB）。
#   2026-09-27 核验补漏：原规则只挡 *.onnx，挡不住 .safetensors —— `git add .` 会一次吞下
#   整个 models/ 目录。这些权重可从 HuggingFace 重新下载，属「可再生派生物」，不入库。
models/**/*.safetensors
models/bge-reranker-large/
models/bge-reranker-v2-m3/
#   漂移实验的一次性嵌入缓存（73 M），派生物
data/knowledge/_audit/_drift_embed_cache.npz

# 外部剧情语料仓库（VioletWilde/Reverse1999-Story-Compendium，约 1 GB）
# 只作为 canon_zh 清洗的**原料**，产物已落 data/lore/wu_ming_zhe/canon_zh/*.compendium.md；
# 按「只入库不可再生种子、派生物不入库」的既有原则排除。重建方式见
# scripts/compendium_canon_corpus.py 头部说明（git clone 即可复现）。
vendor/

# 桌面宠物壳（Electron）
desktop/node_modules/
desktop/dist/
desktop/out/
#   运行期检索埋点（M-11）：默认关；开启时按轮追加，属运行产物不入库
data/knowledge/_audit/retrieval_trace/

# ── 本机运行残留（2026-09-29 整理补充）──────────────────────────────
# 下列目录由 pytest / conftest 在本机生成，属「沙箱产物」，不入库。
# 历史上它们未列入 .gitignore，会持续污染 `git status`。
.pytest_bt/
.pytest_ws/
.pytest_tmp*/
pytest-of-Lenovo/
roleplay_test_qenmhfwr/
_poc_shots/

#   根级一次性探针（已归档到 scripts/_archive/，防复发）
/_cue_feasibility.py
/_strip_test.js

# ── 提交前清理（2026-10-10 提交 P4–P7 时核验补充）────────────────────
# 背景：P4–P7 的 `git status` 累积 200 项，其中混有大量本机运行残留。
# 裸 `git add -A` 会一次吞下 201.9 MB / 2166 个文件（含 747 个垃圾条目），
# 且多为 Electron 缓存与 pytest 临时目录，全部可再生。故在此显式排除。
#
#   Electron 冒烟/截图脚本的产物目录（77 MB 缓存 + 截图，可再生）
desktop/scripts/out/
#   Electron 用户数据与实例缓存（同上，_29524 等随机后缀）
desktop/scripts/out/**/.electron-*/
#   DSH/子代理探查落地目录（本机沙箱产物）
.agent_tmp/
#   pytest basetemp 套件目录（含 20 MB corpus.json 与 .npz，测试可再生）
.bt_suite/
#   一次性探针目录与根级作业清单（P4–P7 派工残留）
/dsh_probe_x/
/_jobs.json
/_jobs2.json
/_p7_jobs.json
/_p7_plan.json
/p4_diag2.py
#   QA 巡检中间日志（结论已汇总进 deliverables/qa_reports/*.md）
deliverables/qa_reports/_logs/
deliverables/qa_reports/_probe.txt
deliverables/qa_reports/_tmpfix_plugin.py

#   派生的重复文本（由已入库的批次 json 经 scripts 摊平/切页生成，可重建）
data/knowledge/_audit/*/_flatten/
data/knowledge/_audit/*/_jl/
data/knowledge/_audit/*/_tmp_*/
data/knowledge/_audit/*/l3_answers/_parts/

# ── 文档整理（2026-10-21）补充的排除项 ────────────────────────────────
#   r11 影子图的完整干跑副本（215 MB，与 data/compendium_rag/ 同构）。
#   它是 P10 修复计划里「真图未动」的证据物，但属**可再生派生物**：
#   由 data/compendium_rag/ + 三条 merge/alias 修复重放即可重建，故不入库。
#   （口径见 docs/compendium-rag/P10修复计划_CBI收口.md「影子图 scratch_r12」一节）
/scratch_r12/
#   本机沙箱 ACL / 权限排障报告（DSH 环境产物，与项目内容无关）
/_acl-recovery/
