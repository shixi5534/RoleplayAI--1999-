# 依赖与虚拟环境
.venv/
__pycache__/
*.pyc
*.egg-info/

# 数据与本地配置
# 原则：只入库「不可再生的种子」，派生产物一律不入库。
#   种子（入库）：data/lore 原始文案、data/characters 角色卡
#   派生（不入库）：向量库 / 图谱 / 抽取缓存 —— 均由种子 + scripts 重建；
#                   且向量库每次重嵌会全量变化，进 git 会让快照体积爆炸
data/*
!data/lore/
!data/characters/
data/lore/_bilibili_tmp/
src/data/
.env
.env.*.local
.env.*.bak*

# 运行日志
logs/

# 测试缓存
.pytest_cache/

# 审计/探针临时目录（沙箱下 pytest 临时目录与探针产物）
tmp_pytest/
.pytest_tmp*/

# 编辑器
.idea/
.vscode/

# 临时/备份文件
*.bak
*.bak-*
*.tmp
*.log

# 一次性抽取/探针产物（勿入库）
_shuzhi_extract.txt
_tmp_pron_edges.txt
docs/_tmp_voicestat.txt

# 第三方可下载模型与语言包（运行时按需下载，不入库）
desktop/resources/ocr/traineddata/

# 桌面宠物壳（Electron）
desktop/node_modules/
desktop/dist/
desktop/out/
